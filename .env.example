# Local development defaults. Do not copy this file unchanged to production.
MOVEINRANGE_ENV=development
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://moveinrange:moveinrange@localhost:5432/moveinrange
TEST_DATABASE_URL=postgresql+psycopg://moveinrange:moveinrange@localhost:5432/moveinrange_test
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8200
ADMIN_BASE_URL=http://localhost:3200
PRODUCT_WEB_BASE_URL=http://localhost:3210
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200,http://localhost:8081,http://127.0.0.1:8081
EXERCISE_DATASET_PATH=../exercises-dataset-main/data/exercises.json
EXERCISE_MEDIA_ROOT=../exercises-dataset-main
AUTH_PROVIDER=local
AUTH_SECRET=replace-with-a-long-random-secret-before-production
TOKEN_ISSUER=moveinrange-api
TOKEN_AUDIENCE=moveinrange-mobile
LOCAL_ADMIN_EMAIL=admin@moveinrange.local
LOCAL_ADMIN_PASSWORD=MoveInRangeAdminLocal!
ENABLE_DEVELOPMENT_ADMIN_OVERRIDE=false
ENABLE_E2E_SEED=false
ADMIN_COOKIE_SECURE=false
AUTH_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_DEVELOPMENT_RESET_PREVIEW=true
EMAIL_SENDER=console
EMAIL_FROM=no-reply@moveinrange.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=
CLERK_JWKS_URL=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8200
NEXT_PUBLIC_API_BASE_URL=http://localhost:8200

# Production/staging checklist:
# ENVIRONMENT=production
# AUTH_SECRET=<long random secret, not the development default>
# LOCAL_ADMIN_PASSWORD=<strong non-default bootstrap password or disabled bootstrap>
# ADMIN_COOKIE_SECURE=true
# ENABLE_DEVELOPMENT_RESET_PREVIEW=false
# ENABLE_E2E_SEED=false
# EMAIL_SENDER=smtp
# SMTP_HOST=<non-local SMTP host, not localhost and not mailpit>
# PRODUCT_WEB_BASE_URL=https://app.example.com
# API_BASE_URL=https://api.example.com
# CORS_ORIGINS=https://admin.example.com,https://app.example.com
# REDIS_URL=<managed redis URL>
