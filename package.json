{
  "name": "move-in-range",
  "version": "0.1.0",
  "private": true,
  "description": "MoveInRange - Health-aware movement planning",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run api",
    "mobile": "npm --workspace @moveinrange/mobile run start",
    "admin": "npm --workspace @moveinrange/admin run dev",
    "api": "python -m uvicorn app.main:app --reload --app-dir services/api --host 127.0.0.1 --port 8000",
    "lint": "node scripts/check-no-placeholders.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "node --test tests/*.test.mjs",
    "build": "npm --workspaces --if-present run build",
    "format:check": "node scripts/check-format.mjs",
    "import:exercises": "node scripts/import-exercises.mjs ../exercises-dataset-main/data/exercises.json",
    "db:migrate": "node scripts/migration-check.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.12"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
