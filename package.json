{
  "name": "move-in-range",
  "version": "0.1.0",
  "private": true,
  "description": "MoveInRange - Health-aware movement planning",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run api",
    "mobile": "npm --workspace @moveinrange/mobile run start",
    "mobile:web": "npm --workspace @moveinrange/mobile run web",
    "mobile:web:build": "npm --workspace @moveinrange/mobile run web:build",
    "product:web:serve": "node scripts/serve-product-web.mjs apps/mobile/.expo-web-export",
    "admin": "npm --workspace @moveinrange/admin run dev",
    "api": "python -m uvicorn app.main:app --reload --app-dir services/api --host 0.0.0.0 --port 8200",
    "lint": "node scripts/check-no-placeholders.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "node --test tests/*.test.mjs",
    "build": "npm --workspaces --if-present run build",
    "format:check": "node scripts/check-format.mjs",
    "import:exercises": "node scripts/import-exercises.mjs",
    "db:migrate": "node scripts/migration-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "checklist:check": "node scripts/check-complete-product-checklist.mjs",
    "e2e:browser": "node --test tests/browser-e2e.test.mjs",
    "e2e:product": "node --test tests/product-e2e.test.mjs",
    "e2e:product-ui": "node --test tests/product-ui-e2e.test.mjs"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.2.2",
    "@playwright/test": "^1.57.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.2.2"
  }
}
