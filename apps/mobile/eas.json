{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8200",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGIN": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.moveinrange.invalid",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGIN": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.moveinrange.invalid",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGIN": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
