ENVIRONMENT=staging
API_BASE_URL=https://staging-api.example.com
ADMIN_BASE_URL=https://staging-admin.example.com
DATABASE_URL=postgresql+psycopg://moveinrange:${POSTGRES_PASSWORD}@postgres:5432/moveinrange
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-secret-manager-value
LOCAL_ADMIN_EMAIL=admin@moveinrange.local
LOCAL_ADMIN_PASSWORD=replace-with-staging-secret
OBJECT_STORAGE_BUCKET=moveinrange-staging
ERROR_TRACKING_DSN=replace-with-dsn
FCM_CREDENTIALS_REF=secret-manager://fcm-staging
APNS_CREDENTIALS_REF=secret-manager://apns-staging
