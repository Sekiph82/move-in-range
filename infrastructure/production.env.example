ENVIRONMENT=production
API_BASE_URL=https://api.example.com
ADMIN_BASE_URL=https://admin.example.com
DATABASE_URL=postgresql+psycopg://moveinrange:${POSTGRES_PASSWORD}@postgres:5432/moveinrange
MIGRATION_DATABASE_URL=postgresql+psycopg://moveinrange:${POSTGRES_PASSWORD}@postgres:5432/moveinrange
SESSION_REVOCATION_BACKEND=postgres
RATE_LIMIT_BACKEND=postgres
AUTH_SECRET=replace-with-secret-manager-value
LOCAL_ADMIN_EMAIL=admin@moveinrange.local
LOCAL_ADMIN_PASSWORD=replace-with-production-secret
EMAIL_SENDER=resend
RESEND_API_KEY=replace-with-secret-manager-value
RESEND_FROM_EMAIL=MoveInRange <no-reply@verified-domain.example>
ENABLE_DEVELOPMENT_RESET_PREVIEW=false
ENABLE_E2E_SEED=false
ADMIN_COOKIE_SECURE=true
OBJECT_STORAGE_BUCKET=moveinrange-production
ERROR_TRACKING_DSN=replace-with-dsn
FCM_CREDENTIALS_REF=secret-manager://fcm-production
APNS_CREDENTIALS_REF=secret-manager://apns-production
